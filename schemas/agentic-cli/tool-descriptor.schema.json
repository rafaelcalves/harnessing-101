{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic CLI tool descriptor v2",
  "type": "object",
  "required": ["schemaVersion", "toolId", "displayName", "descriptorRevision", "deferred", "evidence"],
  "properties": {
    "schemaVersion": {"const": 2},
    "toolId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "displayName": {"type": "string", "minLength": 1},
    "descriptorRevision": {"type": "string", "minLength": 1},
    "deferred": {"type": "boolean"},
    "deferral": {"type": "object", "required": ["reason", "reference"], "properties": {"reason": {"type": "string"}, "reference": {"type": "string"}}},
    "toolSpec": {"$ref": "#/$defs/toolSpec"},
    "evidence": {"type": "object", "required": ["scenarioRef", "scenarioVersion", "plannedInterventions"], "properties": {"scenarioRef": {"type": "string"}, "scenarioVersion": {"type": "string"}, "plannedInterventions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "observationHints": {"type": "array", "items": {"type": "string"}}}}
  },
  "allOf": [{
    "if": {"properties": {"deferred": {"const": true}}},
    "then": {"required": ["deferral"], "not": {"required": ["toolSpec"]}},
    "else": {"required": ["toolSpec"], "not": {"required": ["deferral"]}}
  }],
  "$defs": {
    "toolSpec": {
      "type": "object",
      "required": ["executable", "versionProbe", "invocation", "context", "authentication", "diagnostics"],
      "properties": {
        "executable": {"type": "object", "required": ["lookup"], "properties": {"lookup": {"type": "string", "minLength": 1}}},
        "versionProbe": {"type": "object", "required": ["args", "acceptedExitCodes"], "properties": {"args": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptedExitCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}}, "timeoutSeconds": {"type": "number", "maximum": 120}}},
        "invocation": {"type": "object", "required": ["args", "ioMode"], "properties": {"args": {"type": "array", "items": {"oneOf": [{"type": "object", "required": ["literal"], "additionalProperties": false, "properties": {"literal": {"type": "string"}}}, {"type": "object", "required": ["contextSlot"], "additionalProperties": false, "properties": {"contextSlot": {"type": "string"}}}]}}, "ioMode": {"enum": ["noninteractive-stdio", "stdin", "unsupported"]}}},
        "context": {"type": "object", "required": ["transport", "formatVersion", "encoding", "allowedSlots", "requiredFields"], "properties": {"transport": {"enum": ["argument", "stdin", "context-file"]}, "formatVersion": {"type": "string"}, "encoding": {"const": "utf-8"}, "allowedSlots": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "requiredFields": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "fileLifetime": {"enum": ["none", "run", "workspace"]}}},
        "authentication": {"type": "object", "required": ["strategy"], "properties": {"strategy": {"const": "runtime-diagnostic-hints"}, "notes": {"type": "string"}}},
        "diagnostics": {"type": "object", "required": ["hints"], "properties": {"hints": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "source", "matching", "pattern", "classification"], "properties": {"code": {"type": "string"}, "source": {"enum": ["stdout", "stderr", "exit-status"]}, "matching": {"enum": ["substring", "regex"]}, "pattern": {"type": "string"}, "classification": {"enum": ["authentication_required", "network_egress_refused", "unsupported_invocation"]}}}}}}
      }
    }
  }
}

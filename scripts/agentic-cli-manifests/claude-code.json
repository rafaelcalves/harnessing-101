{
  "schemaVersion": 1,
  "tool": "Claude Code",
  "executable": "claude",
  "version": {"args": ["--version"], "successExitCodes": [0]},
  "auth": {
    "detectionMode": "runtime-output",
    "requiredPatterns": ["login", "authenticate", "api key", "not logged in", "credentials"],
    "networkRefusedPatterns": ["api.anthropic.com", "network is unreachable", "connection refused", "timed out"],
    "notes": "Claude Code has no assumed non-authenticating provider probe here; classify auth/network failures from the first managed invocation. Never log tokens."
  },
  "invocation": {
    "managedStart": {
      "args": ["start-run", "-workspace", "{workspace}", "-workspace-id", "{workspace_id}", "-run", "{run_id}", "-agent", "{agent_id}", "-profile-id", "{profile_id}", "-task", "{task_id}"],
      "contextMode": "profile-context"
    }
  },
  "participation": {
    "requiredSignals": ["task", "workspace", "participation"],
    "completionSignals": ["cycle_completed", "acceptance_history", "ownership"],
    "failureSignals": ["unsupported", "authentication", "network", "spawn"]
  },
  "humanInterventions": ["setup and assignment", "answer blocker", "reject once", "accept corrected result"],
  "friction": ["provider authentication and network reachability are owner/environment responsibilities"]
}
